# Database Configuration
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/briefly"

# App Configuration
PORT="3001"
NODE_ENV="production"

# Cron verification secret (Must match the Authorization header sent from cron-job.org)
CRON_JOB_TOKEN="your_cron_job_token_here"

# FCM Firebase Service Account Credentials (JSON string or Base64 encoded JSON string)
FIREBASE_SERVICE_ACCOUNT="your_firebase_service_account_json_or_base64_here"
